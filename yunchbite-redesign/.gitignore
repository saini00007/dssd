# tooling
tools/node_modules/
# raw captures are large; contact sheets, reports and JSON are committed instead
research/references/**/video/*.webm
research/references/**/video/*.mp4
research/references/**/frames/raw/
research/references/**/hover/**/*.webm
research/_runs/
tools/**/_out/

# harvest: raw rendered-DOM snapshots stay local (copy lives in content.md)
research/current-site/pages/*/dom.html
research/current-site/crawl-state.json
# video analyser: individual per-event frames stay local (strips + sheets are committed)
research/references/**/analysis/**/events/*/frames/
# journey temp dirs
research/references/**/journeys/.tmp-*/
# journeys: per-event strips and 4 fps sheets are regenerable from tools/capture/journeys/*.json; curated key-frames/ are committed instead
research/references/**/journeys/analysis/**/events/
research/references/**/journeys/analysis/**/sheets/
